<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="main-content">
  <div class="page-header">
    <div>
      <h1 class="page-title"><%= title %></h1>
      <p class="page-subtitle">Track compliance actions, review statuses, and upcoming deadlines</p>
    </div>
    <% if (isManager) { %>
      <a href="/tasks/new" class="btn btn-primary">+ Create Compliance Task</a>
    <% } %>
  </div>

  <%- include('../partials/flash') %>

  <!-- Filter Bar (For Manager & Employee) -->
  <div class="filter-card">
    <form action="/tasks" method="GET" class="filter-form">
      <% if (isManager && employees.length > 0) { %>
        <div class="filter-group">
          <label for="employee">Assignee</label>
          <select name="employee" id="employee" onchange="this.form.submit()">
            <option value="">All Team Members</option>
            <% employees.forEach(emp => { %>
              <option value="<%= emp._id %>" <%= filters.employee === emp._id.toString() ? 'selected' : '' %>>
                <%= emp.name %> (<%= emp.userId %>)
              </option>
            <% }) %>
          </select>
        </div>
      <% } %>

      <div class="filter-group">
        <label for="status">Progress Status</label>
        <select name="status" id="status" onchange="this.form.submit()">
          <option value="">All Statuses</option>
          <option value="Pending" <%= filters.status === 'Pending' ? 'selected' : '' %>>Pending</option>
          <option value="In Progress" <%= filters.status === 'In Progress' ? 'selected' : '' %>>In Progress</option>
          <option value="Submitted for Review" <%= filters.status === 'Submitted for Review' ? 'selected' : '' %>>Submitted for Review</option>
        </select>
      </div>

      <div class="filter-group">
        <label for="reviewStatus">Review Status</label>
        <select name="reviewStatus" id="reviewStatus" onchange="this.form.submit()">
          <option value="">All Reviews</option>
          <option value="Not Reviewed" <%= filters.reviewStatus === 'Not Reviewed' ? 'selected' : '' %>>Not Reviewed</option>
          <option value="Changes Requested" <%= filters.reviewStatus === 'Changes Requested' ? 'selected' : '' %>>Changes Requested</option>
          <option value="Verified" <%= filters.reviewStatus === 'Verified' ? 'selected' : '' %>>Verified</option>
        </select>
      </div>

      <div class="filter-group">
        <label for="priority">Priority</label>
        <select name="priority" id="priority" onchange="this.form.submit()">
          <option value="">All Priorities</option>
          <option value="Low" <%= filters.priority === 'Low' ? 'selected' : '' %>>Low</option>
          <option value="Medium" <%= filters.priority === 'Medium' ? 'selected' : '' %>>Medium</option>
          <option value="High" <%= filters.priority === 'High' ? 'selected' : '' %>>High</option>
          <option value="Critical" <%= filters.priority === 'Critical' ? 'selected' : '' %>>Critical</option>
        </select>
      </div>

      <div class="filter-group">
        <label for="overdue">Overdue</label>
        <select name="overdue" id="overdue" onchange="this.form.submit()">
          <option value="">All Deadlines</option>
          <option value="true" <%= filters.overdue === 'true' ? 'selected' : '' %>>Overdue Only</option>
        </select>
      </div>

      <div class="filter-actions">
        <a href="/tasks" class="btn btn-secondary btn-sm">Reset</a>
      </div>
    </form>
  </div>

  <!-- Task Table -->
  <div class="table-responsive">
    <table class="data-table">
      <thead>
        <tr>
          <th>Task Title</th>
          <% if (isManager) { %><th>Assignee</th><% } %>
          <th>Category</th>
          <th>Priority</th>
          <th>Progress Status</th>
          <th>Review Status</th>
          <th>Deadline</th>
          <th class="text-right">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (tasks.length === 0) { %>
          <tr>
            <td colspan="<%= isManager ? 8 : 7 %>" class="empty-state">No matching compliance tasks found.</td>
          </tr>
        <% } %>
        <% tasks.forEach(task => { %>
          <tr>
            <td>
              <a href="/tasks/<%= task._id %>" class="task-link"><strong><%= task.title %></strong></a>
              <% if (task.isOverdue) { %>
                <span class="badge badge-overdue">Overdue</span>
              <% } %>
            </td>
            <% if (isManager) { %>
              <td><%= task.assignee ? task.assignee.name : 'Unassigned' %></td>
            <% } %>
            <td><%= task.category %></td>
            <td><span class="badge badge-priority-<%= task.priority.toLowerCase() %>"><%= task.priority %></span></td>
            <td><%= task.progressStatus %></td>
            <td>
              <% if (task.reviewStatus === 'Verified') { %>
                <span class="badge badge-success">Verified</span>
              <% } else if (task.reviewStatus === 'Changes Requested') { %>
                <span class="badge badge-warning">Changes Requested</span>
              <% } else { %>
                <span class="badge badge-secondary">Not Reviewed</span>
              <% } %>
            </td>
            <td><%= new Date(task.deadline).toLocaleDateString() %></td>
            <td class="text-right table-actions">
              <a href="/tasks/<%= task._id %>" class="btn btn-secondary btn-sm">View</a>
              <% if (isManager) { %>
                <a href="/tasks/<%= task._id %>/edit" class="btn btn-secondary btn-sm">Edit</a>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</main>

<%- include('../partials/footer') %>
