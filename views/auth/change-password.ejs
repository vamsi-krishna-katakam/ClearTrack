<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="main-content">
  <div class="auth-card">
    <div class="auth-header">
      <h2><%= isFirstLogin ? 'Set Initial Password' : 'Change Password' %></h2>
      <p>
        <%= isFirstLogin 
          ? 'You must set a new secure password before accessing your account.' 
          : 'Update your account password below.' 
        %>
      </p>
    </div>

    <%- include('../partials/flash') %>

    <form action="/auth/change-password" method="POST" class="form-stack">
      <% if (!isFirstLogin) { %>
        <div class="form-group">
          <label for="currentPassword">Current Password</label>
          <input type="password" id="currentPassword" name="currentPassword" required>
        </div>
      <% } %>

      <div class="form-group">
        <label for="newPassword">New Password</label>
        <input type="password" id="newPassword" name="newPassword" minlength="6" required placeholder="Minimum 6 characters">
      </div>

      <div class="form-group">
        <label for="confirmPassword">Confirm New Password</label>
        <input type="password" id="confirmPassword" name="confirmPassword" minlength="6" required placeholder="Repeat new password">
      </div>

      <button type="submit" class="btn btn-primary btn-block">Update Password</button>
    </form>
  </div>
</main>

<%- include('../partials/footer') %>
