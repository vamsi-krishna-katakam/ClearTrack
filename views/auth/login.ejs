<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="main-content">
  <div class="auth-card">
    <div class="auth-header">
      <div class="brand-icon auth-logo-icon">✓</div>
      <h2>Sign In to ClearTrack</h2>
      <p>Enter your credentials to access your compliance workspace</p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <%- include('../partials/flash') %>

    <form action="/auth/login" method="POST" class="form-stack">
      <div class="form-group">
        <label for="userId">User ID</label>
        <input 
          type="text" 
          id="userId" 
          name="userId" 
          value="<%= typeof userId !== 'undefined' ? userId : '' %>" 
          required 
          autofocus 
          placeholder="e.g. manager or emp101"
        >
      </div>

      <div class="form-group">
        <label for="password">Password</label>
        <input 
          type="password" 
          id="password" 
          name="password" 
          required 
          placeholder="Enter password"
        >
      </div>

      <button type="submit" class="btn btn-primary btn-block">Sign In &rarr;</button>
    </form>
  </div>
</main>

<%- include('../partials/footer') %>
