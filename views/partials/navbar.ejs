<header class="app-header">
  <div class="nav-container">
    <a href="/" class="brand-logo">
      <span class="brand-icon">✓</span>
      <span class="brand-name">ClearTrack</span>
    </a>
    <nav class="nav-links">
      <% if (locals.user) { %>
        <% if (user.role === 'manager') { %>
          <a href="/dashboard">Dashboard</a>
          <a href="/tasks">All Tasks</a>
          <a href="/employees">Team</a>
          <a href="/audit-logs">Audit Trail</a>
        <% } else { %>
          <a href="/dashboard">My Tasks</a>
        <% } %>
        <span class="user-pill"><%= user.name %> (<%= user.role %>)</span>
        <a href="/auth/logout" class="btn btn-secondary btn-sm">Sign Out</a>
      <% } else { %>
        <a href="/auth/login" class="btn btn-primary btn-sm">Sign In</a>
      <% } %>
    </nav>
  </div>
</header>
